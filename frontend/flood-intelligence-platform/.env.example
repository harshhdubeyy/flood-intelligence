# Browser-visible public values; the API URL may be same-origin or a backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_MAPBOX_TOKEN=<public-mapbox-token>

# Server-only operator session configuration. Never prefix these with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8000/v1
OPERATOR_SESSION_SECRET=<generate-a-random-secret-with-at-least-32-characters>
